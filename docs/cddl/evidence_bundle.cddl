; TrustNotes Evidence Bundle CDDL Definition
; Cryptographic proof of server misbehavior (exportable via `tn evidence export`)

EvidenceBundle = {
  v: 1,
  bundle_kind: evidence-kind,
  account_id: bstr .size 32,
  created_at: uint,                  ; Unix ms when bundle was produced
  evidence: BundleEvidence
}

evidence-kind = (
  merge-deadline-missed: 1 /         ; S10: op receipted but omitted past MMD
  equivocation: 2 /                  ; S12: conflicting roots for same epoch
  split-view: 3                      ; S7: inconsistent checkpoints shown to devices
)

BundleEvidence = (
  MergeDeadlineEvidence /
  EquivocationEvidence /
  SplitViewEvidence
)

MergeDeadlineEvidence = {
  receipt: Receipt,
  checkpoints: [* CheckpointResponse]
}

EquivocationEvidence = {
  epoch: uint,
  root_a: bstr .size 32,
  root_b: bstr .size 32,
  checkpoint_a: CheckpointResponse,
  checkpoint_b: CheckpointResponse
}

SplitViewEvidence = {
  device_a_checkpoint: CheckpointResponse,
  device_b_checkpoint: CheckpointResponse
}

Receipt = {
  v: 1,
  account_id: bstr .size 32,
  op_id: bstr .size 32,
  index: uint,
  account_tree_size_after: uint,
  server_time: uint,
  mmd_epoch: uint,
  sig_ed: bstr .size 64,
  sig_pq: bstr
}

CheckpointResponse = {
  v: 1,
  origin: tstr,
  size: uint,
  root_hash: bstr .size 32,
  timestamp: uint,
  sig_ed: bstr .size 64,
  sig_pq: bstr,
  cosignatures: [* Cosignature]
}

Cosignature = {
  witness_id: bstr .size 32,
  timestamp: uint,
  sig_ed: bstr .size 64
}
